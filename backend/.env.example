# Hustle For Life Backend - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
LOG_LEVEL=info

# Hustle Root Directory (where department folders live)
HUSTLE_ROOT=/home/alfonso/hustle

# Health Data Directory
HEALTH_DATA_DIR=/home/alfonso/hustle/health/data

# Database Connection (if using PostgreSQL for additional storage)
DATABASE_URL=postgresql://hustle:your_password@localhost:5432/hustle_life

# Node Environment
NODE_ENV=production
