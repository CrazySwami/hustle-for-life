# Hustle for Life - Database Configuration
# Copy this file to .env and fill in your values

# PostgreSQL Settings
POSTGRES_DB=hustle_life
POSTGRES_USER=hustle
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Data storage path (on your Proxmox server)
# Example: /mnt/disk1/hustle-db or /var/lib/hustle-db
DATA_PATH=./data

# pgAdmin (optional, for web management)
PGADMIN_EMAIL=admin@hustle.life
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
