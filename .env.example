# Hustle for Life - Environment Configuration
# Copy this file to .env and fill in your values

# Database Connection (your Proxmox PostgreSQL)
DATABASE_URL=postgresql://hustle:your_password@your-proxmox-ip:5432/hustle_life

# NTFY Notifications
NTFY_TOPIC=hustle-life-your-unique-id
NTFY_SERVER=https://ntfy.sh

# Optional: If you self-host NTFY
# NTFY_SERVER=https://your-ntfy-server.com

# Timezone
TZ=Pacific/Auckland
